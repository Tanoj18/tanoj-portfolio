# ==============================================================================
# TANOJ PORTFOLIO - EMAILJS CONFIGURATION (.env.example)
# ==============================================================================
# Contact form messages are delivered directly to: cse05b8@gmail.com
# Copy this file to .env and configure with your keys from https://www.emailjs.com/
#
# 1. VITE_EMAILJS_PUBLIC_KEY: Account > API Keys > Public Key
# 2. VITE_EMAILJS_SERVICE_ID: Email Services > Service ID (connected to Gmail)
# 3. VITE_EMAILJS_TEMPLATE_ID: Email Templates > Template ID (notifications sent to cse05b8@gmail.com)
# 4. VITE_EMAILJS_ACK_TEMPLATE_ID: (Optional) Template ID for visitor auto-reply
# ==============================================================================

VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# Optional: Automatic acknowledgement email to visitor
VITE_EMAILJS_ACK_TEMPLATE_ID=your_ack_template_id
